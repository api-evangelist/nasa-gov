{
  "opencollection": "1.0.0",
  "info": {
    "name": "NASA Astronomy Picture of the Day (APOD) Album Asset API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Asset",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Media Asset Manifest",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nasa.gov/asset/:nasa_id",
            "params": [
              {
                "name": "nasa_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Media Asset Manifest"
        },
        {
          "info": {
            "name": "Get Media Asset Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nasa.gov/metadata/:nasa_id",
            "params": [
              {
                "name": "nasa_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Media Asset Metadata"
        },
        {
          "info": {
            "name": "Get Video Asset Captions Location",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nasa.gov/captions/:nasa_id",
            "params": [
              {
                "name": "nasa_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Video Asset Captions Location"
        }
      ]
    }
  ],
  "bundled": true
}
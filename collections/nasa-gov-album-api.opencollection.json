{
  "opencollection": "1.0.0",
  "info": {
    "name": "NASA Astronomy Picture of the Day (APOD) Album API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Album",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Album Manifest",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nasa.gov/album/:album_name",
            "params": [
              {
                "name": "album_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get Album Manifest"
        }
      ]
    }
  ],
  "bundled": true
}
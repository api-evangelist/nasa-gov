{
  "opencollection": "1.0.0",
  "info": {
    "name": "NASA Astronomy Picture of the Day (APOD) Album Software API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Software",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search NASA Software",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nasa.gov/software",
            "params": [
              {
                "name": "software",
                "value": "",
                "type": "query"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search NASA Software"
        }
      ]
    }
  ],
  "bundled": true
}
                },
                {
                  "disabled": false,
                  "key": "thumbs",
                  "value": "false",
                  "description": "Return the URL of a video thumbnail when the media type is video."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "DEMO_KEY",
                  "description": "(Required) api.nasa.gov key (or DEMO_KEY for evaluation)."

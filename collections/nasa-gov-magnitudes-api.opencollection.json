{
  "opencollection": "1.0.0",
  "info": {
    "name": "NASA Astronomy Picture of the Day (APOD) Album Magnitudes API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Magnitudes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Magnitude Definitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nasa.gov/magnitudes"
          },
          "docs": "Get Magnitude Definitions"
        }
      ]
    }
  ],
  "bundled": true
}
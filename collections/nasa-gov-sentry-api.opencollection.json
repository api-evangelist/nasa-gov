              },
              {
                "name": "des",
                "value": "",
                "type": "query"
              },
              {
                "name": "h-max",
                "value": "",
                "type": "query"
              },
              {
                "name": "ps-min",
                "value": "",
                "type": "query"
              },
              {
                "name": "ip-min",
                "value": "",
                "type": "query"
              },
              {
                "name": "removed",
                "value": "",
                "type": "query"
              },
              {
                "name": "all",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Sentry Impact Risk"
        }
      ]
    }
  ],
  "bundled": true
}